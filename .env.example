# D365 F&O Test Environment Configuration
# Copy this file to .env and fill in actual credentials
# NEVER commit the .env file with real credentials!

# ====================================
# D365 INSTANCE CONFIGURATION
# ====================================
D365_URL=https://your-instance.axcloud.dynamics.com/

# ====================================
# DEFAULT TEST USER (used by global-setup.ts)
# ====================================
# This is the primary user for authentication
# Configure based on which user type you want to use
D365_USERNAME=your-email@company.com
D365_PASSWORD=YourPassword123

# ====================================
# USER TYPE 1: MANAGER (with Direct Reports)
# ====================================
# Use for: MSS tests, manager workflows, team performance management
# Required roles: Employee, People Manager
# Required data: Has direct reports configured
MANAGER_USERNAME=manager-email@company.com
MANAGER_PASSWORD=ManagerPassword123

# ====================================
# USER TYPE 2: STANDARD EMPLOYEE (No Manager Role)
# ====================================
# Use for: ESS tests, employee self-service, negative testing (no manager access)
# Required roles: Employee only (no manager roles)
# Required data: Has performance reviews/goals, compensation data
EMPLOYEE_USERNAME=employee-email@company.com
EMPLOYEE_PASSWORD=EmployeePassword123

# ====================================
# USER TYPE 3: EMPLOYEE (No Banking Info)
# ====================================
# Use for: Banking warning tests (ID-44347)
# Required roles: Employee
# Required data: NO banking information configured (triggers warning)
EMPLOYEE_NO_BANKING_USERNAME=employee-no-bank@company.com
EMPLOYEE_NO_BANKING_PASSWORD=EmployeeNoBankPassword123

# ====================================
# USER TYPE 4: HR ADMINISTRATOR (No Manager Role)
# ====================================
# Use for: Worker/Position CRUD, HR admin workflows
# Required roles: HR Administrator, System User
# Required data: Full People workspace access, can view/edit all employees
HR_ADMIN_USERNAME=hr-admin@company.com
HR_ADMIN_PASSWORD=HRAdminPassword123

# ====================================
# USER TYPE 5: MANAGER (No System Admin)
# ====================================
# Use for: Security testing - compare vs manager with system admin
# Required roles: Employee, People Manager (NO System Administrator)
# Required data: Has direct reports, standard manager permissions only
STANDARD_MANAGER_USERNAME=standard-manager@company.com
STANDARD_MANAGER_PASSWORD=StandardManagerPassword123

# ====================================
# USER TYPE 6: HRBP REWARD ROLE
# ====================================
# Use for: Rewards letter tests (ID-58837)
# Required roles: HRBP Reward role
# Required data: Access to rewards letter management
HRBP_REWARD_USERNAME=hrbp-reward@company.com
HRBP_REWARD_PASSWORD=HRBPRewardPassword123

# ====================================
# USER TYPE 7: MANAGER REWARD ROLE
# ====================================
# Use for: Manager rewards letter tests (ID-58838)
# Required roles: Manager Reward role
# Required data: Access to rewards letters for direct reports
MANAGER_REWARD_USERNAME=manager-reward@company.com
MANAGER_REWARD_PASSWORD=ManagerRewardPassword123

# ====================================
# COMPANY/LEGAL ENTITY CONFIGURATION
# ====================================
# Default legal entity for tests
LEGAL_ENTITY=4415
COMPANY_NAME=GNS

# ====================================
# USAGE NOTES
# ====================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in actual credentials from TEST_USER_CATALOG.md
# 3. Set D365_USERNAME and D365_PASSWORD to your primary test user
# 4. Individual tests can use specific user types via process.env.EMPLOYEE_USERNAME etc.
# 5. NEVER commit .env file - it's in .gitignore for security

# ====================================
# TEST DATA REQUIREMENTS BY USER TYPE
# ====================================
# MANAGER: Must have at least one direct report configured in D365
# EMPLOYEE: Should have active performance reviews and goals
# EMPLOYEE_NO_BANKING: Must NOT have banking disbursement configured
# HR_ADMIN: Should have access to all workers and positions
# STANDARD_MANAGER: Same direct reports as MANAGER but without System Admin role
# HRBP_REWARD: Must have HRBP Reward role assigned in security
# MANAGER_REWARD: Must have Manager Reward role and direct reports
